{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "opencode/deepseek-v4-flash-free",
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "just validate*": "allow",
      "just configure*": "allow",
      "just flate-test*": "allow",
      "pre-commit run*": "allow",
      "python3 scripts/find_mistakes.py*": "allow",
      "kubectl get*": "allow",
      "kubectl describe*": "allow",
      "kubectl logs*": "allow",
      "talosctl get*": "allow",
      "talosctl dmesg*": "allow",
      "talosctl health*": "allow",
      "flux get*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "gh issue*": "allow",
      "gh api*": "allow"
    }
  }
}
