{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      // Client images must match the db.internal server major (Postgres 17).
      // Raise together with the server upgrade in #3197.
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/postgresql/",
        "ghcr.io/home-operations/postgres-init",
        "mirror.gcr.io/prodrigestivill/postgres-backup-local",
      ],
      allowedVersions: "<=17",
    },
    {
      description: "Hold Intel device plugins below 0.37.2 until intel/intel-device-plugins-for-kubernetes#2416 is fixed",
      matchPackageNames: ["/intel-device-plugins-(operator|gpu)/"],
      allowedVersions: "<0.37.2",
    },
  ],
}
