{
  "uid": "cloudflare-zone",
  "title": "Cloudflare Zone Analytics",
  "tags": [
    "cloudflare"
  ],
  "schemaVersion": 41,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "5m",
  "graphTooltip": 1,
  "description": "Queried live from the Cloudflare GraphQL Analytics API through the Infinity datasource. Free-plan limits: 30 days of history, at most 30 days per query.",
  "templating": {
    "list": [
      {
        "name": "bucket",
        "label": "Bucket",
        "type": "custom",
        "query": "5 min : datetimeFiveMinutes, 15 min : datetimeFifteenMinutes, 1 hour : datetimeHour, 1 day : date",
        "current": {
          "text": "1 hour",
          "value": "datetimeHour",
          "selected": true
        },
        "options": [
          {
            "text": "5 min",
            "value": "datetimeFiveMinutes",
            "selected": false
          },
          {
            "text": "15 min",
            "value": "datetimeFifteenMinutes",
            "selected": false
          },
          {
            "text": "1 hour",
            "value": "datetimeHour",
            "selected": true
          },
          {
            "text": "1 day",
            "value": "date",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "cloudflare"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "cloudflare"
          },
          "type": "graphql",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "https://api.cloudflare.com/client/v4/graphql",
          "url_options": {
            "method": "POST",
            "body_type": "graphql",
            "body_graphql_query": "query { viewer { zones(limit: 1) { s: httpRequestsOverviewAdaptiveGroups(limit: 1, filter: {datetime_geq: \"${__from:date:iso}\", datetime_lt: \"${__to:date:iso}\"}) { sum { requests } } } } }"
          },
          "root_selector": "data.viewer.zones.s",
          "columns": [
            {
              "selector": "sum.requests",
              "text": "requests",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
